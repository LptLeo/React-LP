# ============================================
# Catálogo Digital & E-commerce — Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha com seus valores reais.
# Nunca commite o arquivo `.env` (ignorado pelo .gitignore).
# ============================================

# ---------- App ----------
# Porta do servidor (usada quando deploy em Node.js/Express).
PORT=3333

# URL base da API consumida pelo frontend.
# Ex: http://localhost:3333 ou https://seu-dominio.vercel.app
VITE_API_URL=http://localhost:3333

# ---------- MongoDB Atlas (M0 Free Tier) ----------
# String de conexão do MongoDB. Obtenha no Atlas em:
# Database → Connect → Drivers → Connection string
MONGODB_URI=mongodb+srv://<usuario>:<senha>@clustername.mongodb.net/<database>?retryWrites=true&w=majority

# ---------- Autenticação (Área Administrativa) ----------
# Segredo utilizado para assinar os tokens JWT da sessão de administrador.
JWT_SECRET=altere-para-um-segredo-longo-e-aleatorio

# Credenciais do administrador (primeiro acesso / seed).
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=senha-forte-aqui

# ---------- Cloudinary (Upload de Imagens) ----------
# Credenciais da conta Cloudinary (Dashboard → Account Details).
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret

# Upload Preset unsigned para uploads diretos a partir do frontend
# (opcional — usado em envio direto via widget/API).
VITE_CLOUDINARY_UPLOAD_PRESET=seu-upload-preset